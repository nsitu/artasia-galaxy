# Development
IMMICH_URL=https://photos.artsforall.co
IMMICH_API_KEY=your-api-key-here
DATA_DIR=../../data
WORDPRESS_URL=https://artsforall.co

# Shared secret required to call POST /api/v1/reconcile (mutates Immich tags).
# GET /api/v1/reconcile/drift is public (read-only). Generate with: openssl rand -hex 32
RECONCILE_SECRET=your-reconcile-secret-here

# Set to 1 to suppress the non-mutating drift report logged at server boot.
# RECONCILE_SKIP_BOOT_DRIFT=0

# Production (inside Docker)
# IMMICH_URL=http://127.0.0.1:2283
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://galaxy.artsforall.co/api/v1/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=artsforall.co
SESSION_SECRET=<long random value>
