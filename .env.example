# Development
IMMICH_URL=https://photos.artsforall.co
IMMICH_API_KEY=your-api-key-here
DATA_DIR=../../data
WORDPRESS_URL=https://artsforall.co

# Public Mapbox token used by the browser to load terrain DEM and satellite tiles.
# Restrict the token to localhost during development.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Shared secret required to call POST /api/v1/reconcile (mutates Immich tags).
# GET /api/v1/reconcile/drift is public (read-only). Generate with: openssl rand -hex 32
RECONCILE_SECRET=your-reconcile-secret-here

# Set to 1 to suppress the non-mutating drift report logged at server boot.
# RECONCILE_SKIP_BOOT_DRIFT=0

# Production (inside Docker)
# IMMICH_URL=http://127.0.0.1:2283
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://atlas.artsforall.co/api/v1/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=artsforall.co

# Optional Google Drive audio import overrides.
# AUDIO_FRAME_PATH=/app/assets/audio-frame.png
# DRIVE_AUDIO_MAX_DURATION_SECONDS=7200
# DRIVE_AUDIO_CONVERSION_TIMEOUT_MS=1800000

# Optional video rotation timeout (default: 2 hours).
# VIDEO_ROTATION_TIMEOUT_MS=7200000
SESSION_SECRET=<long random value>
